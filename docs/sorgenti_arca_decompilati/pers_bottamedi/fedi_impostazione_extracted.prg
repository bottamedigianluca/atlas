	.ToolTipText = 'Listino storico ' + Iif(IsEmpty(cDescText), '', ' - ' + Rtrim(cDescText))
EndWith



ENDPROC
PROCEDURE isvalid
LParameters lIsChanged, xOldValue

Local xRet
xRet = DoDefault(lIsChanged, xOldValue)
If Empty(xRet)
	Return xRet
EndIf


ENDPROC

