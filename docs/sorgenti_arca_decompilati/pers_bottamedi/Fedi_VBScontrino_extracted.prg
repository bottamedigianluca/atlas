*** METHODS ***
PROCEDURE xnettoisvalid
Lparameters lIsChanged, xOldValue
LOCAL xPesoNetto

IF !((BITAND(ThisForm.Mode, FEDIMODE_EDIT) = 0) AND (BITAND(ThisForm.Mode, FEDIMODE_INS_DUP) = 0)) THEN 
	xPesoNetto = THISFORM.xAssegnaPesoNetto()
	This.PF.PgGenerale.GrdRighe.ColPrezzoUnitarioV.Text1.OnValueChange(VBSconR.PrezzoUnitario-1) 
ENDIF

RETURN DODEFAULT(lIsChanged, xOldValue)

ENDPROC
PROCEDURE xassegnapesonetto
&& Calcola il netto (Quantità) in base a Colli,Tara e peso lordo 
LOCAL nColli, nLordo, nTara, nPesoNetto
		
	nColli 	= VBSconR.xColli
	nLordo 	= VBSconR.xLordo
	nTara  	= VBSconR.xTara

	IF !EMPTY(nLordo) THEN 	
	   	nPesoNetto = nLordo - (nColli * nTara)
	   	ELSE
	   	nPesoNetto = nColli
	ENDIF
	
   	REPLACE Qta 			WITH nPesoNetto	IN VBSconR
   	

RETURN nPesoNetto
ENDPROC
PROCEDURE PF.PGGENERALE.grdRighe.Init
LOCAL oCol1, oCol2
LOCAL myInputMask

&& myInputMask  = THIS.ColQta.InputMask  && "###,###.##" 
myInputMask  = THISFORM.DE.Preferenza.PicSepQta

	** Grid.Init 

	** Numero colli / quantità (Custom)
	oCol1 = This.newColumn('xColColli', 'VBSconR.xColli', 'Colli/Qta', 100)
	oCol1.InputMask = myInputMask
	BINDEVENT(oCol1.StdText1,"IsValid", ThisForm, "xNettoIsValid")

	** Peso lordo
	oCol2 = This.newColumn('xColLordo', 'VBSconR.xLordo', 'Lordo', 100)
	oCol2.InputMask = myInputMask  
	BINDEVENT(oCol2.StdText1,"IsValid", ThisForm, "xNettoIsValid")

	** Tara 
	oCol3 = This.newColumn('xColTara', 'VBSconR.xTara', 'Tara', 100)
	oCol3.InputMask = myInputMask  
	BINDEVENT(oCol3.StdText1,"IsValid", ThisForm, "xNettoIsValid")

	** Disabilito l'input della quantità
	THIS.ColQTA.Enabled = .F.
	THIS.ColQTA.Header1.Caption = 'Q.ta/Netto '	

DODEFAULT()


ENDPROC

