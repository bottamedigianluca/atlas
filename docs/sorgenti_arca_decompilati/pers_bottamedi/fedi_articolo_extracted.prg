*** METHODS ***
PROCEDURE querysave
Lparameters lInsertMode
DODEFAULT(lInsertMode)
cStmt = "SELECT TOP 1 xARIvaObb FROM Preferenza"
oPref = xSqlExec2Obj(cStmt)

IF oPref.xARIvaObb
	IF IsEmpty(AR.Cd_Aliquota_V) THEN 
		xMessageBox("Attenzione non è stata inserita l'aliquota IVA per le vendite")
		RETURN .F.
		ELSE
		RETURN .T.
	ENDIF
ENDIF
ENDPROC
PROCEDURE PF.Init
LOCAL oPage
oPage  = This.NewPage('xPGAltro', 'Altro')
MNewObject1(oPage, 'cnt', 'xPGAltro', Thisform.ClassLibrary, '', oPage)
RETURN DODEFAULT()

ENDPROC

